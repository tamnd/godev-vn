# Upstream has no .gitignore, so this file is the fork's and it is short on
# purpose. Only things this fork's own tooling drops into the tree.

# The audit report, written by `godev audit -report` and uploaded by CI.
audit.md

# The export, written by `godev publish`. It is a hundred megabytes of HTML
# rebuilt from the content on every deploy, so it belongs in a deploy artifact
# and not in history.
dist/

.DS_Store
